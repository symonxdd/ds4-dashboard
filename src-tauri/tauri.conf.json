{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DS4 Dashboard",
  "version": "1.4.0",
  "identifier": "com.symon.ds4-dashboard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DS4 Dashboard",
        "label": "main",
        "width": 867,
        "height": 569,
        "resizable": true,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#060606",
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVFMDcwMzMzRUJDRDc1NEUKUldST2RjM3JNd01IWGsvS3Y0TW05cmxwVmJ4ZDM4ZExIMWhXakJnSGJvOUZRT0tlWGV6OWUyZkEK",
      "endpoints": [
        "https://github.com/symonxdd/ds4-dashboard/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
